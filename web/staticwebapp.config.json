{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/login.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/sem-acesso.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/styles.css", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/login.html" },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/*", "allowedRoles": ["usuario"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login.html", "statusCode": 302 },
    "403": { "rewrite": "/sem-acesso.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
